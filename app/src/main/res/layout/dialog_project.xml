<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <EditText android:id="@+id/etProjectName"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Project name (max 60)" android:inputType="textCapWords" android:singleLine="true"/>
        <EditText android:id="@+id/etProjectTag"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Project tag (max 20)" android:inputType="text" android:singleLine="true"/>
        <EditText android:id="@+id/etProjectDescription"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Project description (max 500)" android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" android:gravity="top"/>

        <LinearLayout android:id="@+id/layoutAttachment"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
            <TextView android:id="@+id/tvAttachmentName"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="No attachment selected (optional)" android:textColor="#6B7280"/>
            <Button android:id="@+id/btnPickAttachment"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Select"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>